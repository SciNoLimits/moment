<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="moment">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import moment urdf file -->
    <xacro:include filename="$(find moment_mujoco)/urdf/moment_mujoco.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="moment.ros2_control.xacro" />


    <xacro:moment_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>

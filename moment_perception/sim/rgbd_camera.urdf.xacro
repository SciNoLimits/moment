<?xml version="1.0"?>
<!--
  RGB-D camera for the MOMENT robot in Gazebo Harmonic.
  Include it in the robot xacro (moment_description) and call:
     <xacro:include filename="$(find moment_perception)/sim/rgbd_camera.urdf.xacro"/>
     <xacro:rgbd_camera parent="base_link" xyz="0.07 0 0.20" rpy="0 0.5 0"/>
  xyz/rpy: where the camera sits and how far it tilts down (pitch 0.5 rad ~ 29 deg).
  Pick them so the pickup area is in view when the robot is parked at the pickup location.

  IMPORTANT: images must be stamped in an OPTICAL frame (z forward, x right, y down).
  Gazebo uses the link frame (x forward) by default, which rotates every 3-D point wrong.
  gz_frame_id below points the sensor at camera_optical_frame to fix that.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rgbd_camera" params="parent xyz rpy">

    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="camera_link">
      <visual>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
        <material name="camera_grey"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <collision><geometry><box size="0.025 0.09 0.025"/></geometry></collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <link name="camera_optical_frame"/>

    <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>camera</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>   <!-- 60 deg -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moment_orchestration</name>
  <version>0.0.0</version>
  <description>High-level task orchestration for the MOMENT autonomous mobile manipulation system</description>
  <maintainer email="prajwal.dutta@stud.th-deg.de">scinolimits</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>moment_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
